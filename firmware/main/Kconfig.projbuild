menu "Dot: Apps"

    comment "Swipe left or right to move between the enabled apps. Only the one on screen runs."

    config DOT_APP_CI
        bool "CI status orb"
        default n

    config DOT_APP_SPOTIFY
        bool "Spotify now playing"
        default y

    config DOT_APP_CPU
        bool "CPU gauge"
        default n

    config DOT_APP_EQUITY
        bool "EquityWatch portfolio"
        default y

    config DOT_APP_USAGE
        bool "Claude token usage"
        default n

    config DOT_USAGE_STANDALONE
        bool "Claude usage: fetch on the device, no host needed"
        depends on DOT_APP_USAGE && DOT_WIFI
        default y
        help
            The device asks api.anthropic.com for your 5-hour and 7-day plan utilization over
            Wi-Fi, once a minute. Without a host it shows percentages and reset times, but not
            token counts (those come from transcripts on your computer). While `dot-host usage`
            is running the host's fuller data is shown instead. Needs a Wi-Fi board. Give the
            device its Wi-Fi and Claude token once with `dot-host setup`.

endmenu

menu "Dot: Radios"
    depends on DOT_BOARD_AMOLED_2_16

    comment "Wi-Fi and Bluetooth LE only connect and show their status for now."

    config DOT_WIFI
        bool "Wi-Fi"
        default y

    config DOT_WIFI_SSID
        string "Network name (SSID)"
        depends on DOT_WIFI
        default ""
        help
            Leave empty to keep Wi-Fi off. Kept in the local, git-ignored sdkconfig.

    config DOT_WIFI_PASSWORD
        string "Network password"
        depends on DOT_WIFI
        default ""

    config DOT_BLUETOOTH
        bool "Bluetooth LE"
        default y
        select BT_ENABLED
        help
            Advertises as "dot" and reports when a device connects. Needs the NimBLE host, which
            sdkconfig.defaults selects (a Kconfig select cannot pick a choice member).

endmenu
