# Flash and partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Octal PSRAM. Fetching instructions and rodata from it frees internal RAM and
# helps the RGB panel reach a higher pixel clock with its framebuffer in PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# LVGL
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y

# Speed. LVGL draws in software and its code and data run through the caches, so the clock, the
# optimization level and the data cache set how fast a screen redraws. Leave the instruction
# cache at 16 KB: 32 KB boots with ESP-IDF 6.0 but makes the PlatformIO build (ESP-IDF 5.5) reset
# in a loop before it logs anything.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Radios (Dot: Radios, AMOLED only). NimBLE is the small Bluetooth LE host, and Wi-Fi/lwIP buffers
# go to PSRAM to leave internal RAM for the display's draw buffers.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Internal RAM is tight (the display takes ~90 KB for draw buffers), so keep the radios and TLS
# small. Wi-Fi: fewer buffers, no IRAM-resident hot paths. Bluetooth only advertises.
# TLS (the usage app's HTTPS request) allocates from PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
